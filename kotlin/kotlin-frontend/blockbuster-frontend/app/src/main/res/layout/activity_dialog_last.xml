<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/containerLayout"
        android:layout_width="350dp"
        android:layout_height="400dp"
        android:background="@drawable/popup_design"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvDiscomfortType"
            android:layout_width="307dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingLeft="10dp"
            android:paddingBottom="8dp"
            android:text="민원이 접수되었습니다."
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivAttachedImage"
            android:layout_width="250dp"
            android:layout_height="200dp"
            android:contentDescription="첨부 이미지"
            android:src="@drawable/design_dialog_ok"
            android:layout_marginTop="10dp"
            android:paddingBottom="8dp"
            android:layout_gravity="center"
            android:scaleType="center"
            android:background="@drawable/popup_design"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMyComplaints"
                android:layout_width="2000dp"
                android:layout_height="60dp"
                android:layout_margin="30dp"
                android:layout_weight="1"
                android:background="@drawable/popup_button_design"
                android:backgroundTint="@null"
                android:text="확인하기"
                android:textSize="19dp"
                app:backgroundTint="@null" />
        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
